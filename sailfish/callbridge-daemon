def load_config():
    cfg = dict(DEFAULTS)
    path = os.environ.get(
        "CALLBRIDGE_CONF",
        os.path.expanduser("~/.config/callbridge/callbridge.conf"))
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, val = line.split("=", 1)
                cfg[key.strip()] = val.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    for key in DEFAULTS:
        if key in os.environ:
            cfg[key] = os.environ[key]
    cfg["DROP_DIR"] = os.path.expanduser(cfg["DROP_DIR"])
    return cfg


