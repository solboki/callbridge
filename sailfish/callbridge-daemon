_recent = {}


def seen_recently(sig, window=8.0):
    now = time.time()
    for k in [k for k, t in _recent.items() if now - t > window]:
        del _recent[k]
    if sig in _recent:
        return True
    _recent[sig] = now
    return False


# --------------------------------------------------------------------------
# Échos de Callbridge dans le centre de notifications Sailfish
#
# AppSupport recopie chaque notification Android dans le centre de
# notifications de Sailfish : un SMS y apparaît donc deux fois. Le service
# repère l'appel Notify de cette copie, lit dans la réponse le numéro que
# Sailfish lui a attribué, puis la referme (CloseNotification). Garmin
# Connect, lui, a déjà lu la notification côté Android : la montre la reçoit.
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# Choix des applications (fichier écrit par l'application de réglage)
#
# ~/.config/callbridge/apps.json :
#   {"sms": true, "missed": true, "calls": true, "apps": ["Courriel", ...]}
# Les clés absentes reprennent les valeurs du fichier callbridge.conf.
#
# ~/.config/callbridge/seen-apps.json : applications natives ayant déjà
# publié une notification, pour que l'interface puisse les proposer. Seuls
# le nom, la catégorie, la date et l'origine (native ou Android) y figurent,
# jamais le contenu des notifications.
# --------------------------------------------------------------------------

APPS_FILE = os.path.expanduser("~/.config/callbridge/apps.json")
SEEN_FILE = os.path.expanduser("~/.config/callbridge/seen-apps.json")
_choices = {"mtime": None, "data": {}}
_seen = {"data": None, "saved": 0.0}
_seen_lock = threading.Lock()
_origins = {}             # expéditeur D-Bus -> "native" ou "android"


def choices():
    try:
        mtime = os.path.getmtime(APPS_FILE)
    except OSError:
        _choices.update(mtime=None, data={})
        return {}
    if mtime != _choices["mtime"]:
        try:
            with open(APPS_FILE, encoding="utf-8") as fh:
                data = json.load(fh)
            _choices.update(mtime=mtime, data=data if isinstance(data, dict) else {})
        except (OSError, ValueError) as exc:
            log("apps.json illisible:", exc)
    return _choices["data"]


def wants(key, conf_key):
    value = choices().get(key)
    if isinstance(value, bool):
        return value
    return CFG[conf_key] == "1"


def selected_apps():
    apps = choices().get("apps")
    return set(apps) if isinstance(apps, list) else set()


def sender_origin(sender):
    """Native (Sailfish) ou Android (copie faite par AppSupport) ?"""
    if sender in _origins:
        return _origins[sender]
    origin = "native"
    try:
        out = subprocess.run(
            ["dbus-send", "--session", "--print-reply",
             "--dest=org.freedesktop.DBus", "/org/freedesktop/DBus",
             "org.freedesktop.DBus.GetConnectionUnixProcessID",
             "string:" + sender],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            universal_newlines=True, timeout=3).stdout
        pid = re.search(r"uint32 (\d+)", out).group(1)
        with open("/proc/%s/cmdline" % pid, "rb") as fh:
            cmd = fh.read().replace(b"\0", b" ").decode("utf-8", "replace").lower()
        if any(w in cmd for w in ("apkd", "appsupport", "alien", "aliendalvik")):
            origin = "android"
    except Exception:
        pass
    _origins[sender] = origin
    return origin


def record_seen(app, category, sender, builtin):
    with _seen_lock:
        if _seen["data"] is None:
            try:
                with open(SEEN_FILE, encoding="utf-8") as fh:
                    _seen["data"] = json.load(fh)
            except (OSError, ValueError):
                _seen["data"] = {}
        data = _seen["data"]
        now = int(time.time())
        entry = data.get(app)
        is_new = entry is None
        if is_new:
            entry = data[app] = {"count": 0}
        entry.update(category=category, last=now, builtin=builtin,
                     origin=sender_origin(sender))
        entry["count"] = entry.get("count", 0) + 1
        if is_new or time.time() - _seen["saved"] > 60:
            try:
                os.makedirs(os.path.dirname(SEEN_FILE), exist_ok=True)
                tmp = SEEN_FILE + ".tmp"
                with open(tmp, "w", encoding="utf-8") as fh:
                    json.dump(data, fh, ensure_ascii=False, indent=1)
                os.rename(tmp, SEEN_FILE)
                _seen["saved"] = time.time()
            except OSError as exc:
                dbg("seen-apps.json:", exc)


# --------------------------------------------------------------------------
# Copies de Callbridge dans Sailfish
#
# AppSupport recopierait chaque notification Callbridge dans Sailfish (son,
# bannière, page des événements). Le paquet installe pour cela
# /etc/appsupport.conf.d/95-callbridge.conf, qui place Callbridge sur la liste
# noire du pont d'AppSupport : la copie n'est jamais créée, et la notification
# reste intacte côté Android pour l'application de la montre. Si une copie
# arrive malgré tout (réglage absent ou AppSupport pas encore redémarré), le
# service la reconnaît et l'ignore.
# --------------------------------------------------------------------------

CALLBRIDGE_PACKAGE = "org.callbridge.relay"


def is_echo(app_name, hints=None):
    if isinstance(hints, dict) and hints.get("x-nemo-origin-package") == CALLBRIDGE_PACKAGE:
        return True
    return str(app_name).strip().lower() in OWN_APP_NAMES


def on_notify(header, args):
    if header["type"] != "method call" or header["member"] != "Notify":
        return
    if len(args) < 7:
        dbg("Notify incomplet:", args)
        return
    app_name, replaces_id, _icon, summary, body, _actions, hints = args[:7]
    hints = hints if isinstance(hints, dict) else {}
    category = str(hints.get("category", ""))
    summary = str(hints.get("x-nemo-preview-summary") or summary or "")
    body = str(hints.get("x-nemo-preview-body") or body or "")
    dbg("Notify app=%r cat=%r résumé=%r corps=%r indices=%s" %
        (app_name, category, summary, body, sorted(hints.keys())))

    if is_echo(app_name, hints):
        return
    if not summary and not body:
        return

    app = str(app_name)
    kind = None
    by_app = False
    is_sms = category in SMS_CATEGORIES or \
        (not category and app in csv_set(CFG["SMS_APPS"]))
    is_missed = category in MISSED_CALL_CATEGORIES or \
        (not category and app in csv_set(CFG["MISSED_CALL_APPS"]))
    try:
        record_seen(app, category, header["sender"], is_sms or is_missed)
    except Exception as exc:          # ne jamais bloquer la transmission
        log("recensement impossible:", exc)
    if is_sms:
        kind = "sms" if wants("sms", "FORWARD_SMS") else None
    elif is_missed:
        kind = "missed" if wants("missed", "FORWARD_MISSED_CALLS") else None
        by_app = category not in MISSED_CALL_CATEGORIES
    elif app in selected_apps() or category in csv_set(CFG["EXTRA_CATEGORIES"]) \
            or app in csv_set(CFG["EXTRA_APPS"]):
        if sender_origin(header["sender"]) == "android":
            dbg("notification Android ignorée (déjà vue par l'application de la montre)")
            return
        kind = "other"
    if not kind:
        return

    if seen_recently((kind, summary, body)):
        dbg("doublon ignoré")
        return

    if kind == "missed" and by_app:
        # Sans catégorie, on ne sait pas comment le texte est composé :
        # on le transmet tel que Sailfish l'affiche.
        title, text = summary or tr("Phone"), body
    elif kind == "missed":
        title = tr("Missed call")
        text = summary if not body or body == summary else \
            "%s : %s" % (summary, body)
    elif kind == "other":
        # La montre affiche « Callbridge » comme source : on rappelle l'application.
        title = "%s · %s" % (app, summary) if summary else app
        text = body
    else:
        title, text = summary, body
    drop({"action": "post", "kind": kind,
          "key": "%s-%d-%d" % (kind, abs(hash((summary, body))) % 10**8,
                               int(time.time())),
          "title": title, "text": text, "app": str(app_name)})


# --------------------------------------------------------------------------
# Appels entrants (oFono, bus système)
# --------------------------------------------------------------------------

_calls = {}   # chemin de l'appel -> clé de notification


CONTACTS_DB = os.path.expanduser(
    "~/.local/share/system/privileged/Contacts/qtcontacts-sqlite/contacts.db")
_contacts_warned = False


def digits(number):
    return re.sub(r"\D", "", number or "")


def lookup_contact(number):
    """Cherche le nom d'un numéro dans le carnet d'adresses de Sailfish.

    Le carnet est une base SQLite réservée aux applications « privilégiées » :
    selon la version du système, le service peut ne pas y avoir accès. Dans
    ce cas on renvoie une chaîne vide et l'application Android fera la
    recherche dans sa propre copie des contacts.
    Comparaison sur les 9 derniers chiffres : 06 12 34 56 78 et
    +33 6 12 34 56 78 désignent ainsi le même numéro.
    """
    global _contacts_warned
    if CFG.get("LOOKUP_CONTACTS", "1") != "1":
        return ""
    want = digits(number)[-9:]
    if len(want) < 6:
        return ""
    try:
        import sqlite3
        db = sqlite3.connect("file:%s?mode=ro" % CONTACTS_DB, uri=True,
                             timeout=1)
        try:
            rows = db.execute(
                "SELECT c.displayLabel, p.phoneNumber FROM PhoneNumbers p "
                "JOIN Contacts c ON c.contactId = p.contactId").fetchall()
        finally:
            db.close()
    except Exception as exc:
        if not _contacts_warned:
            log("carnet Sailfish inaccessible (%s) : la recherche du nom "
                "sera faite côté Android" % exc)
            _contacts_warned = True
        return ""
    for label, phone in rows:
        if label and digits(phone)[-9:] == want:
            dbg("contact trouvé côté Sailfish:", label)
            return str(label)
    return ""


def call_key(path):
    # oFono réutilise le même chemin (/ril_0/voicecall01) pour chaque appel :
    # on ajoute l'heure pour qu'aucune application compagnon ne prenne un
    # nouvel appel pour une notification déjà transmise.
    return "call-%s-%d" % (re.sub(r"[^A-Za-z0-9]", "_", path), int(time.time()))


def on_ofono(header, args):
    if header["type"] != "signal":
        return
    member, iface = header["member"], header["interface"]

    if iface == "org.ofono.VoiceCallManager" and member == "CallAdded":
        if len(args) < 2 or not isinstance(args[1], dict):
            return
        path, props = args[0], args[1]
        state = props.get("State", "")
        log("oFono: appel %s (%s)" % (state, path))
        dbg("CallAdded", path, props)
        if state not in ("incoming", "waiting"):
            return
        if not wants("calls", "FORWARD_INCOMING_CALLS"):
            return
        number = props.get("LineIdentification") or ""
        if number in ("withheld", ""):
            number = ""
        name = props.get("Name") or (lookup_contact(number) if number else "")
        _calls[path] = call_key(path)
        label = tr("Incoming call") if state == "incoming" else tr("Call waiting")
        shown = number or tr("Private number")
        if name:
            title, text = name, "%s · %s" % (label, shown)
        else:
            title, text = label, shown
        drop({"action": "post", "kind": "call", "key": _calls[path],
              "title": title, "text": text, "label": label,
              "number": number, "name": name})

    elif iface == "org.ofono.VoiceCallManager" and member == "CallRemoved":
        path = args[0] if args else header["path"]
        log("oFono: fin d'appel (%s)" % path)
        key = _calls.pop(path, None)
        if key:
            drop({"action": "cancel", "kind": "call", "key": key})

    elif iface == "org.ofono.VoiceCall" and member == "PropertyChanged":
        path = header["path"]
        if len(args) >= 2 and args[0] == "State" and \
                args[1] in ("active", "disconnected"):
            key = _calls.pop(path, None)
            if key:
                drop({"action": "cancel", "kind": "call", "key": key})


# --------------------------------------------------------------------------

def main():
    if "--version" in sys.argv:
        print(VERSION)
        return
    if "--icon" in sys.argv:
        # callbridge-daemon --icon hide|show|status  (utilisé par l'application de réglage)
        arg = sys.argv[sys.argv.index("--icon") + 1] if len(sys.argv) > sys.argv.index("--icon") + 1 else "status"
        if arg in ("hide", "show"):
            rep = set_icon_hidden(arg == "hide")
        else:
            rep = {"hidden": os.path.exists(ICON_FLAG),
                   "launchers": [{"path": p, "method": "edited" if os.access(p, os.W_OK) else "override"}
                                 for p in android_launchers()], "changed": []}
        print(json.dumps(rep))
        return
    if "--test" in sys.argv:
        drop({"action": "post", "kind": "test", "key": "test",
              "title": "Callbridge", "text": tr("Test from Sailfish OS")})
        return

    # Interrupteur de l'application de réglage : tant que ce fichier existe,
    # le service s'arrête aussitôt (code 0, donc systemd ne le relance pas).
    if os.path.exists(DISABLED_FLAG) and "--force" not in sys.argv:
        log("désactivé par", DISABLED_FLAG)
        return

    log("version", VERSION, "- dossier d'échange:", CFG["DROP_DIR"])
    os.makedirs(CFG["DROP_DIR"], exist_ok=True)

    threads = [threading.Thread(target=cleaner, daemon=True),
               threading.Thread(target=icon_keeper, daemon=True),
               threading.Thread(target=watchdog, daemon=True)]
    threads.append(threading.Thread(target=monitor, daemon=True, args=(
        "session",
        ["type='method_call',interface='org.freedesktop.Notifications',"
         "member='Notify'"],
        on_notify)))
    # Toujours à l'écoute d'oFono : le choix « appels entrants » se lit à
    # chaque appel, pour qu'un changement dans l'interface s'applique aussitôt.
    threads.append(threading.Thread(target=monitor, daemon=True, args=(
        CFG["OFONO_BUS"],
        ["type='signal',interface='org.ofono.VoiceCallManager'",
         "type='signal',interface='org.ofono.VoiceCall',"
         "member='PropertyChanged'"],
        on_ofono)))
    for t in threads:
        t.start()
    try:
        while True:
            time.sleep(3600)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
