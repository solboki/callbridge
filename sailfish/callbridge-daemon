def phone_language():
    """Language of the phone: LANGUAGE setting, then LANG, then Sailfish's locale file."""
    if CFG.get("LANGUAGE"):
        return CFG["LANGUAGE"][:2].lower()
    lang = os.environ.get("LC_ALL") or os.environ.get("LANG") or ""
    if not lang:
        for path in ("/var/lib/environment/nemo/locale.conf",
                     os.path.expanduser("~/.config/locale.conf")):
            try:
                with open(path, encoding="utf-8") as fh:
                    for line in fh:
                        if line.startswith("LANG="):
                            lang = line.split("=", 1)[1].strip().strip('"')
            except OSError:
                pass
    return lang[:2].lower()


