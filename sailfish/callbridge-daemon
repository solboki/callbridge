# --------------------------------------------------------------------------
# Analyse de la sortie de dbus-monitor
# --------------------------------------------------------------------------

HEADER_RE = re.compile(
    r"^(method call|signal|method return|error) time=\S+ sender=(\S+) -> "
    r"destination=(.*?) serial=(\S+)(?: reply_serial=(\S+))?"
    r"(?:;? path=(\S+); interface=(\S+); member=(\S+))?")


class DictEntry:
    __slots__ = ("key", "value")

    def __init__(self, key, value):
        self.key, self.value = key, value


VALUE_START_RE = re.compile(
    r"\s*(?:string|signature|object|u?int(?:16|32|64)|byte|double|boolean|"
    r"variant|array|dict|struct|unix|\]|\)|\})")


def string_ends_here(text, i):
    """dbus-monitor n'échappe pas les guillemets à l'intérieur des chaînes.

    Un guillemet ne ferme donc la chaîne que s'il termine sa ligne et que la
    ligne suivante commence par un mot-clé de valeur (ou si c'est la fin).
    Exemple : le SMS « On dit "midi" ? » reste entier.
    """
    j = i + 1
    while j < len(text) and text[j] in " \t\r":
        j += 1
    if j >= len(text):
        return True
    if text[j] != "\n":
        return False
    rest = text[j + 1:]
    return not rest.strip() or bool(VALUE_START_RE.match(rest))


def tokenize(text):
    """Découpe le corps d'un message en jetons.

    Les chaînes entre guillemets peuvent contenir des retours à la ligne et
    des guillemets échappés ; elles sont rendues sous forme ('S', valeur).
    """
    tokens = []
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c.isspace():
            i += 1
            continue
        if c == '"':
            i += 1
            buf = []
            while i < n:
                ch = text[i]
                if ch == '"' and string_ends_here(text, i):
                    break
                buf.append(ch)
                i += 1
            tokens.append(("S", "".join(buf)))
            i += 1
            continue
        if c in "[]{}()":
            tokens.append(("P", c))
            i += 1
            continue
        j = i
        while j < n and not text[j].isspace() and text[j] not in '[]{}()"':
            j += 1
        tokens.append(("W", text[i:j]))
        i = j
    return tokens


class Parser:
    def __init__(self, tokens):
        self.t = tokens
        self.i = 0

    def peek(self):
        return self.t[self.i] if self.i < len(self.t) else (None, None)

    def take(self):
        tok = self.peek()
        self.i += 1
        return tok

    def parse_all(self):
        values = []
        while self.i < len(self.t):
            values.append(self.value())
        return values

    def value(self):
        kind, tok = self.take()
        if kind != "W":
            return tok
        if tok == "string" or tok == "signature":
            return self.take()[1]
        if tok == "object":            # object path "..."
            self.take()
            return self.take()[1]
        if tok in ("int16", "uint16", "int32", "uint32", "int64", "uint64",
                   "byte"):
            v = self.take()[1]
            try:
                return int(v, 0)
            except (TypeError, ValueError):
                return v
        if tok == "double":
            try:
                return float(self.take()[1])
            except (TypeError, ValueError):
                return None
        if tok == "boolean":
            return self.take()[1] == "true"
        if tok == "variant":
            return self.value()
        if tok == "unix":              # unix fd N
            self.take()
            self.take()
            return None
        if tok == "array":
            if self.peek() == ("W", "of"):     # array of bytes
                self.take()
                self.take()
                k, v = self.take()
                if k == "S":
                    return v
                depth = 1
                while depth and self.i < len(self.t):
                    k, v = self.take()
                    if (k, v) == ("P", "["):
                        depth += 1
                    elif (k, v) == ("P", "]"):
                        depth -= 1
                return b""
            self.take()                        # [
            items = []
            while self.peek() not in (("P", "]"), (None, None)):
                items.append(self.value())
            self.take()                        # ]
            if items and all(isinstance(x, DictEntry) for x in items):
                return {x.key: x.value for x in items}
            return items
        if tok == "dict":                      # dict entry(
            self.take()                        # "entry"
            self.take()                        # (
            key = self.value()
            val = self.value()
            if self.peek() == ("P", ")"):
                self.take()
            return DictEntry(key, val)
        if tok == "struct":
            self.take()                        # {
            items = []
            while self.peek() not in (("P", "}"), (None, None)):
                items.append(self.value())
            self.take()
            return items
        return tok


def parse_body(text):
    try:
        return Parser(tokenize(text)).parse_all()
    except Exception as exc:  # analyse défensive : on ne plante jamais
        dbg("échec d'analyse:", exc)
        return []


def monitor(bus, rules, on_message):
    """Lance dbus-monitor et appelle on_message(header, args) par message.

    Relance automatiquement dbus-monitor s'il s'arrête.
    """
    cmd = ["dbus-monitor", "--" + bus] + rules
    while True:
        dbg("lancement:", " ".join(cmd))
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE,
                                    encoding="utf-8", errors="replace")
        except FileNotFoundError:
            log("dbus-monitor introuvable, arrêt.")
            sys.exit(1)
        # Un message n'a pas de marque de fin : on le considère complet quand
        # le suivant commence ou quand aucune ligne n'arrive pendant 0,3 s.
        lines = queue.Queue()

        def reader():
            for ln in proc.stdout:
                lines.put(ln)
            lines.put(None)

        threading.Thread(target=reader, daemon=True).start()
        header, body = None, []

        def flush():
            try:
                on_message(header, parse_body("".join(body)))
            except Exception as exc:
                log("erreur de traitement:", exc)

        while True:
            try:
                line = lines.get(timeout=0.3)
            except queue.Empty:
                if header:
                    flush()
                    header, body = None, []
                continue
            if line is None:
                break
            m = HEADER_RE.match(line)
            if m:
                if header:
                    flush()
                header = {
                    "type": m.group(1), "sender": m.group(2),
                    "destination": m.group(3), "serial": m.group(4),
                    "reply_serial": m.group(5),
                    "path": m.group(6), "interface": m.group(7),
                    "member": m.group(8),
                }
                body = []
            elif header is not None:
                body.append(line)
        if header:
            flush()
        err = proc.stderr.read().strip()
        log("dbus-monitor (%s) s'est arrêté (code %s) %s"
            % (bus, proc.wait(), err))
        time.sleep(5)


# --------------------------------------------------------------------------
# Dépôt des événements pour le conteneur Android
# --------------------------------------------------------------------------

_lock = threading.Lock()
_seq = 0


def drop(event):
    """Écrit un événement de façon atomique (fichier temporaire + renommage)."""
    global _seq
    with _lock:
        _seq += 1
        d = CFG["DROP_DIR"]
        os.makedirs(d, exist_ok=True)
        event["ts"] = int(time.time() * 1000)
        name = "%d-%04d.json" % (event["ts"], _seq % 10000)
        tmp = os.path.join(d, "." + name + ".tmp")
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(event, fh, ensure_ascii=False)
        os.chmod(tmp, 0o666)
        os.rename(tmp, os.path.join(d, name))
        log("événement déposé:", event.get("action"), event.get("key"),
            "|", event.get("title", ""))


def cleaner():
    """Supprime les fichiers jamais consommés (application Android arrêtée)."""
    stale = int(CFG["STALE_SECONDS"])
    while True:
        time.sleep(30)
        d = CFG["DROP_DIR"]
        try:
            now = time.time()
            for f in os.listdir(d):
                p = os.path.join(d, f)
                if f.endswith(".json") or f.endswith(".tmp"):
                    if now - os.path.getmtime(p) > stale:
                        os.remove(p)
                        dbg("fichier périmé supprimé:", f)
        except OSError:
            pass


# --------------------------------------------------------------------------
# Icône de l'application Android dans le lanceur Sailfish
#
# AppSupport crée un raccourci (.desktop) pour chaque application Android.
# Pour masquer celui de Callbridge, on y ajoute NoDisplay=true, la convention
# standard des lanceurs. Si le fichier n'est pas modifiable par l'utilisateur,
# on dépose une copie marquée NoDisplay=true dans ~/.local/share/applications.
# Comme AppSupport peut régénérer ses raccourcis, le service réapplique le
# masquage toutes les minutes tant que l'option est active.
# --------------------------------------------------------------------------

ANDROID_PACKAGE = "org.callbridge.relay"
ICON_FLAG = os.path.expanduser("~/.config/callbridge/android-icon-hidden")
SYSTEM_APP_DIRS = ["/usr/share/applications"]
USER_APP_DIR = os.path.expanduser("~/.local/share/applications")
OVERRIDE_MARK = "# Callbridge override: hides the Callbridge Android icon"


def _read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def android_launchers():
    """Raccourcis créés par AppSupport pour l'application Android (hors copies)."""
    found = []
    for d in SYSTEM_APP_DIRS + [USER_APP_DIR]:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            p = os.path.join(d, n)
            if n.endswith(".desktop"):
                text = _read(p)
                if ANDROID_PACKAGE in text and OVERRIDE_MARK not in text:
                    found.append(p)
    return found


def with_nodisplay(text, hidden):
    """Retire toute ligne NoDisplay de [Desktop Entry], puis l'ajoute si besoin."""
    out, section = [], ""
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            section = stripped
        if section == "[Desktop Entry]" and stripped.startswith("NoDisplay="):
            continue
        out.append(line)
        if hidden and stripped == "[Desktop Entry]":
            out.append("NoDisplay=true")
    return "\n".join(out) + "\n"


def _write(path, text):
    tmp = path + ".callbridge-tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.rename(tmp, path)


def apply_icon(hidden):
    """Applique l'état voulu ; renvoie un compte rendu (chemins, méthode)."""
    report = {"hidden": hidden, "launchers": [], "changed": []}
    originals = android_launchers()
    names = set()
    for p in originals:
        names.add(os.path.basename(p))
        text = _read(p)
        if os.access(p, os.W_OK):
            method = "edited"
            new = with_nodisplay(text, hidden)
            if new != text:
                _write(p, new)
                report["changed"].append(p)
        else:
            method = "override"
            ov = os.path.join(USER_APP_DIR, os.path.basename(p))
            if hidden:
                new = OVERRIDE_MARK + "\n" + with_nodisplay(text, True)
                if _read(ov) != new:
                    os.makedirs(USER_APP_DIR, exist_ok=True)
                    _write(ov, new)
                    report["changed"].append(ov)
            elif OVERRIDE_MARK in _read(ov):
                os.remove(ov)
                report["changed"].append(ov)
        report["launchers"].append({"path": p, "method": method})
    # Copies devenues orphelines (application Android désinstallée)
    try:
        for n in os.listdir(USER_APP_DIR):
            ov = os.path.join(USER_APP_DIR, n)
            if n not in names and OVERRIDE_MARK in _read(ov):
                os.remove(ov)
                report["changed"].append(ov)
    except OSError:
        pass
    return report


def set_icon_hidden(hidden):
    os.makedirs(os.path.dirname(ICON_FLAG), exist_ok=True)
    if hidden:
        open(ICON_FLAG, "w").close()
    elif os.path.exists(ICON_FLAG):
        os.remove(ICON_FLAG)
    return apply_icon(hidden)


def icon_keeper():
    while True:
        if os.path.exists(ICON_FLAG):
            try:
                rep = apply_icon(True)
                if rep["changed"]:
                    log("icône Android masquée de nouveau:", rep["changed"])
            except OSError as exc:
                dbg("masquage impossible:", exc)
        time.sleep(60)


# --------------------------------------------------------------------------
# Chien de garde du relais Android
#
# Quand AppSupport s'arrête, Android force l'arrêt de ses applications. Une
# application arrêtée de force ne reçoit plus le signal de démarrage du
# système tant qu'on ne l'a pas ouverte à la main : après un redémarrage, le
# relais restait donc muet. Le service surveille le fichier d'état du relais ;
# s'il vieillit alors qu'Android tourne, il ouvre l'application Android avec
# une marque « autostart » : elle démarre son relais et se referme aussitôt.
# --------------------------------------------------------------------------

STATE_STALE_SECONDS = 90
KICK_INTERVAL_SECONDS = 300
KICKS_PER_ANDROID_SESSION = 3


def android_session():
    """PID de system_server (le cœur d'Android) s'il tourne, sinon None."""
    try:
        pids = os.listdir("/proc")
    except OSError:
        return None
    for pid in pids:
        if pid.isdigit():
            try:
                with open("/proc/%s/comm" % pid) as fh:
                    if fh.read().strip() == "system_server":
                        return pid
            except OSError:
                pass
    return None


def relay_state_age():
    try:
        return time.time() - os.path.getmtime(
            os.path.join(CFG["DROP_DIR"], "relay.state"))
    except OSError:
        return None


def launch_android_app():
    """Exécute la ligne Exec du raccourci créé par AppSupport."""
    import shlex
    for path in android_launchers():
        for line in _read(path).splitlines():
            if line.startswith("Exec="):
                cmd = [a for a in shlex.split(line[5:])
                       if not (len(a) == 2 and a.startswith("%"))]
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
                return True
    return False


def watchdog():
    session, kicks, last_kick = None, 0, 0.0
    time.sleep(45)                      # laisser au relais le temps de démarrer seul
    while True:
        try:
            current = android_session()
            if current != session:
                session, kicks = current, 0
            age = relay_state_age()
            stale = age is None or age > STATE_STALE_SECONDS
            if (current and stale and CFG["AUTOSTART_ANDROID"] == "1"
                    and kicks < KICKS_PER_ANDROID_SESSION
                    and time.time() - last_kick > KICK_INTERVAL_SECONDS):
                marker = os.path.join(CFG["DROP_DIR"], "autostart.request")
                open(marker, "w").close()
                os.chmod(marker, 0o666)
                if launch_android_app():
                    kicks += 1
                    last_kick = time.time()
                    log("relais Android muet : réveil de l'application (%d/%d)"
                        % (kicks, KICKS_PER_ANDROID_SESSION))
        except Exception as exc:
            dbg("chien de garde:", exc)
        time.sleep(30)


