# Callbridge settings
# Copy this file to ~/.config/callbridge/callbridge.conf, then restart:
#   systemctl --user restart callbridge

# Folder shared with Android (seen as /sdcard/Callbridge inside the container)
DROP_DIR=~/android_storage/Callbridge

# 1 = forward, 0 = ignore
FORWARD_SMS=1
FORWARD_MISSED_CALLS=1
FORWARD_INCOMING_CALLS=1

# App names under which Sailfish posts SMS and missed calls
# (used when the notification carries no category; Sailfish OS 5 posts
# SMS as "Messages"). Names may depend on the phone's language.
SMS_APPS=Messages,commhistoryd,jolla-messages
MISSED_CALL_APPS=Phone,Téléphone,Appels,voicecall-ui,jolla-voicecall

# Other native notifications to forward, by category or by app name.
# To find the exact names: stop the service, run  callbridge-daemon --debug
# then trigger the notification and read the "Notify app=... cat=..." lines.
# Examples:
# EXTRA_CATEGORIES=x-nemo.email
# EXTRA_APPS=harbour-fernschreiber,harbour-whisperfish
EXTRA_CATEGORIES=
EXTRA_APPS=

# Language of the texts shown on the watch (en, fr). Empty = phone language.
LANGUAGE=

# Look up the caller's name in the address book (1 = yes)
LOOKUP_CONTACTS=1

# Remove from the Sailfish notification area the copies AppSupport makes of
# Callbridge's notifications, which duplicate the original SMS or call
# (1 = yes). The watch still receives them.
HIDE_ECHO=1
# Other app names under which these copies may appear, if not recognised.
# Run  callbridge-daemon --debug  to see the exact name ("Notify app=...").
ECHO_APPS=

# Wake the Android relay when it stops answering while Android runs (1 = yes).
# After AppSupport restarts, Android only restarts apps that were opened by
# hand; the service opens Callbridge silently instead.
AUTOSTART_ANDROID=1

# An event not picked up by Android is deleted after this delay (seconds)
STALE_SECONDS=120

# 1 = verbose log (journalctl --user -u callbridge -f)
DEBUG=0
